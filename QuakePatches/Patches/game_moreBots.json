    {
      // qxGameSettings::Apply - Make the emitted "maxplayers N" cover the bots.
      // Apply sends `maxplayers <settings+0x54>`, which is the $m_max_players
      // slider and is capped at 8 (16 with lobby_maxplayers16). svs.maxclients
      // follows it, so AddBot runs out of client slots long before %cap%.
      // Rewritten in place, no length change, to send maxPlayers + bot_numBots
      // (bot_numBots is already clamped to %cap% - cl_localplayers just above):
      //   MOV  [RBP-0x59],EAX     -> ADD EAX,[RBX+0x50]   add bot_numBots
      //   MOVAPS XMM0,[RBP-0x59]  -> MOV [RBP-0x49],EAX   store the format arg
      //   MOVDQA [RBP-0x49],XMM0  -> NOPs                 staging copy is gone
      // [RBP-0x59] is only staging for that copy (it is overwritten with the
      // format-string pointer right after), and XMM0 is reloaded before its
      // next use, so both are dead here.
      // Touches no byte of lobby_maxplayers16 - that patch edits the
      // $m_max_players slider cap in FUN_1403ac310 and the co-op `mov edi,4`
      // at the top of Apply, both well clear of this window.
      "id": "patch_apply_maxplayers",
      "pattern": [
        "8b 43 54",                 // MOV EAX, [RBX+0x54]        settings.maxPlayers
        "4c 8d 45 a7",              // LEA R8, [RBP-0x59]
        "89 45 a7",                 // MOV [RBP-0x59], EAX
        "48 8d 55 f7",              // LEA RDX, [RBP-0x9]
        "0f 28 45 a7",              // MOVAPS XMM0, [RBP-0x59]
        "48 8d 05 ** ** ** **",     // LEA RAX, [maxplayers format string]
        "48 89 45 a7",              // MOV [RBP-0x59], RAX
        "48 8b 45 2f",
        "48 89 45 ef",
        "48 8d 45 b7",              // LEA RAX, [RBP-0x49]
        "0f 10 4d e7",
        "48 c7 45 af 0e 00 00 00",
        "66 0f 7f 45 b7"            // MOVDQA [RBP-0x49], XMM0
      ],
      "replacements": [
        {
          "index": 7,
          "bytes": "03 43 50"
        },
        {
          "index": 14,
          "bytes": "89 45 B7 90"
        },
        {
          "index": 53,
          "bytes": "90 90 90 90 90"
        }
      ]
    },
